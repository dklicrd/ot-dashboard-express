# OT Dashboard - Configuración
PORT=3000
JWT_SECRET=cambia-este-secret-por-uno-seguro

# SMTP para envío de emails (Gmail recomendado)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contrasena-de-app
SMTP_FROM=noreply@ot-dashboard.com

# URL del dashboard (para links en emails)
DASHBOARD_URL=http://localhost:3000
